# Copy to .env and fill in. Never commit .env.

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://onboarding:onboarding@localhost:5432/onboarding

# --- MAX messenger -----------------------------------------------------------
# Token from "MAX для бизнеса". The bot must be verified before the token is issued.
MAX_BOT_TOKEN=
# The same value you pass to POST /subscriptions; MAX sends it in X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=
# Prod: path to the Russian trusted root CA bundle (Mincifry) when calling MAX.
# MAX_CA_BUNDLE=/etc/ssl/certs/russian_trusted_root_ca.pem
MAX_MESSAGES_PER_SECOND=2

# --- LLM ---------------------------------------------------------------------
# GigaChat in production: data stays in Russia. OpenAI-compatible mode is for dev/eval.
# extractive: offline demo/eval only, rejected when ENVIRONMENT=production.
LLM_PROVIDER=gigachat
LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
LLM_API_KEY=
LLM_MODEL=GigaChat-2-Pro
LLM_TIMEOUT_S=8
LLM_MAX_TOKENS=700
LLM_MAX_RETRIES=1
# Static headers for OpenAI-compatible gateways, JSON. OpenCode Go needs a session header.
# LLM_EXTRA_HEADERS={"x-opencode-session":"onboarding","x-opencode-client":"pi"}

# --- embeddings --------------------------------------------------------------
# hashing: offline demo/eval only. gigachat/openai need a key.
EMBED_PROVIDER=gigachat
EMBED_MODEL=Embeddings
# Must match the vector width in the schema (1024). Changing it needs a migration.
EMBED_DIM=1024
# Separate gateway for embeddings (OpenRouter, vLLM, TEI). Empty means LLM_BASE_URL.
EMBED_BASE_URL=
EMBED_API_KEY=

# --- reranker ----------------------------------------------------------------
# Empty RERANK_BASE_URL disables the stage and keeps the hybrid order.
# Cohere-shaped POST {base}/rerank: Cohere, Jina, OpenRouter.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_S=3

# --- sentiment classifier ----------------------------------------------------
# prompt: the versioned chat prompt in docs/prompts/sentiment/. jev: TypeSafe Jev rubric.
# Jev needs a TypeSafe key; without one the process refuses to start, by design.
SENTIMENT_PROVIDER=prompt
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_TIMEOUT_S=8
JEV_MAX_RETRIES=2

# --- answer quality ----------------------------------------------------------
ANSWER_MIN_CONFIDENCE=0.45
RECALL_LIMIT=30
RERANK_LIMIT=5

# --- recruiter cabinet -------------------------------------------------------
# token:role:subject, comma separated. Roles: recruiter, hr_admin.
# Use long random tokens; rotate with a deploy.
ADMIN_TOKENS=dev-recruiter-token:recruiter:rec-1,dev-hr-token:hr_admin:hr-1

# --- tunnel (docker compose --profile tunnel) --------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
