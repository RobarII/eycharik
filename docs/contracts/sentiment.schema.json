{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshackathon.local/contracts/sentiment.schema.json",
  "title": "SentimentSignal",
  "description": "Один вердикт классификатора по одному свободному ответу на опрос. Модель возвращает этот объект; воркер проверяет его до записи или эскалации.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentiment", "tags", "risk", "confidence", "reason"],
  "properties": {
    "sentiment": {"enum": ["positive", "neutral", "negative", "unknown"]},
    "tags": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tag"}
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Одна короткая фраза для рекрутёра. Без имён, без цитат длиннее десяти слов."
    },
    "escalate_to": {"enum": ["recruiter", "hr", "none"]}
  },
  "$defs": {
    "tag": {
      "enum": [
        "access",
        "manager",
        "colleagues",
        "workload",
        "clarity",
        "hr",
        "it",
        "integration",
        "other"
      ]
    }
  }
}
