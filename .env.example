# Copy to .env only if you need to override a default. The demo and `make verify` need no .env:
# `make demo` fills PostgreSQL, answers with the extractive provider and hashes embeddings locally.
# Real providers (GigaChat, OpenRouter, OpenCode) live in .env.production.example.

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://onboarding:onboarding@localhost:5432/onboarding

# --- channels ----------------------------------------------------------------
# Which messengers are on. Default: max. Every other name needs credentials below and a linked
# account; docs/runbooks/channels.md turns one on. An unknown name fails at startup.
CHANNELS=max
# Profile files live in apps/api/channel-profiles/<channel>.yaml; CHANNEL_PROFILES_DIR overrides
# the directory, which only tests do.

# --- MAX messenger -----------------------------------------------------------
# Token from "MAX для бизнеса". The bot must be verified before the token is issued.
MAX_BOT_TOKEN=
# The same value you pass to POST /subscriptions; MAX sends it in X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=
# Prod: path to the Russian trusted root CA bundle (Mincifry) when calling MAX.
# MAX_CA_BUNDLE=/etc/ssl/certs/russian_trusted_root_ca.pem
MAX_MESSAGES_PER_SECOND=2

# --- Telegram ----------------------------------------------------------------
# CHANNELS must include telegram. Token from @BotFather; the secret is what Telegram echoes in
# X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- VK ----------------------------------------------------------------------
# CHANNELS must include vk. All three are required: a missing confirmation code leaves the channel
# unconfigured and its webhook answers 503.
VK_ACCESS_TOKEN=
VK_WEBHOOK_SECRET=
VK_CONFIRMATION_CODE=
# VK_API_VERSION=5.199

# --- models ------------------------------------------------------------------
# A model is a profile file: apps/api/model-profiles/<role>/<name>.yaml, validated by
# docs/contracts/model-profile.schema.json (ADR 0013). The profile owns the dialect, the
# capabilities (json mode, token field, reasoning effort), the envelope, and the prices.
# A profile is required: there is no environment-built model fallback (ADR 0021).
# Offline defaults: no key, no network, deterministic answers. A reviewer needs nothing else.
# For a hosted model set LLM_PROVIDER=openai, LLM_BASE_URL, LLM_API_KEY and a profile below.
LLM_PROFILE=
EMBED_PROFILE=local-hashing
# RERANK_PROFILE=openrouter-cohere-rerank-v3.5

# --- LLM ---------------------------------------------------------------------
# GigaChat in production: data stays in Russia. OpenAI-compatible mode is for dev/eval.
# extractive: offline demo/eval only, rejected when ENVIRONMENT=production.
LLM_PROVIDER=extractive
LLM_BASE_URL=
LLM_API_KEY=
# Optional overrides of the profile. Unset means "the profile decides".
# LLM_MAX_TOKENS=700
# LLM_TIMEOUT_S=8
# LLM_MAX_RETRIES=1
# Prices belong to the profile; override only for a deployment-negotiated price.
# LLM_PRICE_INPUT_RUB_PER_1K=
# LLM_PRICE_OUTPUT_RUB_PER_1K=
# LLM_PRICE_CACHE_READ_RUB_PER_1K=
# Static headers for OpenAI-compatible gateways, JSON. OpenCode Go needs a session header.
# LLM_EXTRA_HEADERS={"x-opencode-session":"onboarding","x-opencode-client":"pi"}

# --- embeddings --------------------------------------------------------------
# hashing: offline demo/eval only. gigachat/openai need a key and a profile.
EMBED_PROVIDER=hashing
# Must equal the selected profile's dim and the kb_chunks.embedding width (1024).
# A different width is a migration plus a reindex, never a setting.
EMBED_DIM=1024
# Separate gateway for embeddings (OpenRouter, vLLM, TEI). Empty means LLM_BASE_URL.
EMBED_BASE_URL=
EMBED_API_KEY=

# --- reranker ----------------------------------------------------------------
# Empty RERANK_BASE_URL disables the stage and keeps the hybrid order.
# Cohere-shaped POST {base}/rerank: Cohere, Jina, OpenRouter.
RERANK_BASE_URL=
RERANK_API_KEY=
# Read only when RERANK_PROFILE is empty; one of the two is required with a base URL.
RERANK_MODEL=
RERANK_TIMEOUT_S=3
# The whole stage, retries included. A free endpoint answers 429 in bursts, and unbounded retries
# at an 8 s timeout reach 32 s of the user's wait.
RERANK_DEADLINE_S=6

# --- retrieval experiments ---------------------------------------------------
# Both are off everywhere. ADR 0012 keeps BM25 out of the request path until a larger corpus says
# otherwise; ADR 0016 keeps contextual retrieval unaccepted until it is measured.
BM25_ENABLED=false
CONTEXTUAL_RETRIEVAL=false
CONTEXTUAL_PROMPT_VERSION=1
CONTEXTUAL_CONTEXT_MAX_CHARS=400

# --- sentiment classifier ----------------------------------------------------
# prompt: the versioned chat prompt in docs/prompts/sentiment/. jev: TypeSafe Jev rubric.
# Jev needs a TypeSafe key; without one the process refuses to start, by design.
SENTIMENT_PROVIDER=prompt
# The classifier is a profile (ADR 0020): apps/api/model-profiles/classify/<name>.yaml names the
# model, the rubric, the envelope, and the input price. It is required for the jev provider.
# jev-1.13.0 talks to TypeSafe directly; openrouter-jev-1.14 uses the same System One path with the
# OpenRouter key you already have (JEV_BASE_URL=https://openrouter.ai/api/v1).
CLASSIFY_PROFILE=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
# Overrides of the profile, for an experiment; None means "the profile decides".
# RUBRIC overrides the profile's rubric selector, e.g. sentiment-jev@2. A wording change is a new file.
SENTIMENT_RUBRIC=

# --- extraction --------------------------------------------------------------
# How to read an uploaded file: apps/api/model-profiles/extract/<name>.yaml, validated by
# docs/contracts/extraction-profile.schema.json (ADR 0015). "native" reads PDF and PPTX text
# layers and refuses scans; "doc-scan" recognizes them with PP-OCRv5 and needs `uv sync --extra ocr`.
EXTRACTION_PROFILE=native
EXTRACTION_MAX_PAGES=200
# A page larger than this answers 413 at the API boundary, before anything is stored.
EXTRACTION_MAX_UPLOAD_BYTES=26214400

# --- answer quality ----------------------------------------------------------
ANSWER_MIN_CONFIDENCE=0.45
RECALL_LIMIT=30
RERANK_LIMIT=5

# --- recruiter cabinet -------------------------------------------------------
# token:role:subject[:YYYY-MM-DD], comma separated.
# Roles: recruiter (own pipeline), manager (one department), hr_admin (everything).
# The optional date is the last valid day; omit it only for a local demo.
# Use long random tokens; rotate with a deploy.
ADMIN_TOKENS=dev-recruiter-token:recruiter:rec-1,dev-manager-token:manager:ИТ,dev-hr-token:hr_admin:hr-1:2030-12-31

# Retention window for questions and the personal parts of audit rows, in days.
DATA_RETENTION_DAYS=365

# Bearer token for /metrics. Empty keeps it open for a local demo; production refuses to start
# without it.
METRICS_TOKEN=

# --- tunnel (docker compose --profile tunnel) --------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
