# Live demo with real models and no budget: the free OpenRouter tier.
# Copy to .env.live and run `make demo-live`. Never commit .env.live.
#
# Two warnings before you spend time on it:
#   1. The free tier has a daily cap (a few dozen requests). A conversation fits, `make eval` does not.
#   2. Free embeddings are not offered by OpenRouter, so this profile keeps the local hashing
#      embedder: answers are real, retrieval is not production retrieval. For measured quality use
#      the paid profiles in .env.production.example and record the run in docs/measurements/.

ENVIRONMENT=local
CHANNELS=max
MAX_BOT_TOKEN=demo-token
MAX_WEBHOOK_SECRET=dev-secret
ADMIN_TOKENS=dev-recruiter-token:recruiter:rec-1,dev-hr-token:hr_admin:hr-1

# --- answer model: free tier -------------------------------------------------
LLM_PROVIDER=openai
LLM_PROFILE=openrouter-free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# A cheaper alternative that is not free but costs about 0.07 RUB per answer:
# LLM_PROFILE=openrouter-gpt-4.1-mini

# --- embeddings: local, no key ----------------------------------------------
EMBED_PROVIDER=hashing
EMBED_PROFILE=local-hashing
EMBED_DIM=1024

# --- rerank: off -------------------------------------------------------------
# The free cross-encoder (nvidia/nemotron-3.5-rerank-8b:free) answers 429 in bursts and ADR 0008
# degrades to fusion, so leaving it off is honest and reproducible.
RERANK_PROFILE=
RERANK_BASE_URL=
RERANK_API_KEY=

# Paid retrieval, if you want the measured numbers instead of the demo:
# EMBED_PROVIDER=openai
# EMBED_PROFILE=openrouter-qwen3-embedding-8b
# EMBED_BASE_URL=https://openrouter.ai/api/v1
# EMBED_API_KEY=
# RERANK_PROFILE=openrouter-cohere-rerank-v3.5
# RERANK_BASE_URL=https://openrouter.ai/api/v1
# RERANK_API_KEY=
