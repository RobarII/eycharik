{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshackathon.local/contracts/rag-answer.schema.json",
  "title": "Answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "citations", "confidence", "escalate", "reason"],
  "properties": {
    "answer": {"type": "string", "minLength": 1, "maxLength": 1500},
    "citations": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*#[0-9]+$"},
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "escalate": {"type": "boolean"},
    "reason": {
      "type": "string",
      "enum": ["answered", "no_sources", "low_confidence", "restricted", "out_of_scope"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"escalate": {"const": false}}},
      "then": {"properties": {"citations": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"escalate": {"const": true}}},
      "then": {"properties": {"reason": {"enum": ["no_sources", "low_confidence", "restricted", "out_of_scope"]}}}
    }
  ]
}
