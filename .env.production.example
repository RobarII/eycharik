# Production environment for one VM running docker compose.
#
# Copy to /opt/onboarding/.env.prod, fill the secrets, chmod 600, never commit it.
# `ENVIRONMENT=production` makes the process refuse to start without the required secrets.
# Compose uses this file twice: `--env-file` for ${...} substitution, `env_file` for containers.

# --- release -----------------------------------------------------------------
# Full registry prefix; the images are <IMAGE_PREFIX>-api and <IMAGE_PREFIX>-admin.
# Set this once; scripts/deploy-remote.sh fills only TAG.
IMAGE_PREFIX=ghcr.io/p4ulbr4dl3y/moshackathon
TAG=replace-with-commit-sha
DOMAIN=bot.state3407.space
PUBLIC_URL=https://bot.state3407.space
API_PORT=18000
ADMIN_PORT=13000

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- database ----------------------------------------------------------------
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=onboarding
DATABASE_URL=postgresql+asyncpg://onboarding:replace-with-a-long-random-password@postgres:5432/onboarding

# --- MAX messenger -----------------------------------------------------------
CHANNELS=max
MAX_BOT_TOKEN=replace-with-max-bot-token
MAX_WEBHOOK_SECRET=replace-with-max-webhook-secret
MAX_MESSAGES_PER_SECOND=2
# The API image installs the Russian Trusted CA into the system bundle and sets this itself.
MAX_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- VK ----------------------------------------------------------------------
# To host a VK community bot alongside MAX: set CHANNELS=max,vk and fill all three.
# VK posts to https://<DOMAIN>/webhook/vk; the existing nginx /webhook/ route already covers it.
# A channel without its secret and confirmation code is not registered (404), never open.
# VK_ACCESS_TOKEN=replace-with-community-token
# VK_WEBHOOK_SECRET=replace-with-callback-secret
# VK_CONFIRMATION_CODE=replace-with-callback-confirmation-code
# Operator-only, for groups.getCallbackServers and scripts/channel_smoke.py:
# VK_GROUP_ID=

# --- models ------------------------------------------------------------------
# A production deployment carries employee messages, so the default here is the Russian contour
# (ADR 0030). The demo stack below is cross-border and belongs to the demo only (ADR 0025): it must
# never be the default of a deployment that stores personal data.
#
# Open item before the pilot: ADR 0030 names GigaChat3.1-10B-A1.8B with bge-m3 and bge-reranker-v2-m3,
# and those profiles do not exist in apps/api/model-profiles yet. Until they do, gigachat-2-pro is the
# only Russian-hosted answer profile on disk; its price is 0 until the Sber invoice anchors it.
LLM_PROFILE=gigachat-2-pro
LLM_PROVIDER=gigachat
LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
LLM_API_KEY=replace-with-gigachat-key
EMBED_PROFILE=gigachat-embeddings
EMBED_PROVIDER=gigachat
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=1024
# Demo only, never for personal data: OpenCode Go answers, OpenRouter embeddings.
# LLM_PROFILE=opencode-deepseek-v4.1-flash
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://opencode.ai/inference/go/v1
# LLM_API_KEY=replace-with-opencode-key
# LLM_EXTRA_HEADERS='{"x-opencode-session":"onboarding","x-opencode-client":"pi"}'
# EMBED_PROFILE=openrouter-qwen3-embedding-8b
# EMBED_PROVIDER=openai
# EMBED_BASE_URL=https://openrouter.ai/api/v1
# EMBED_API_KEY=replace-with-openrouter-key
# Empty disables the rerank stage; enable only with a reachable endpoint and a measured gain.
RERANK_PROFILE=
RERANK_BASE_URL=
RERANK_API_KEY=

# --- sentiment ---------------------------------------------------------------
# auto: CLASSIFY_API_KEY -> decisions, else the configured answer model -> prompt, else the keyword
# floor (ADR 0029). Pin a provider only to freeze one path for a measurement.
#
# A 152-ФЗ pilot keeps CLASSIFY_API_KEY empty on purpose: the decisions path sends the employee's text
# to TypeSafe, which is cross-border, so the pilot classifies with a prompt on the answer model
# (ADR 0030). Fill the key only for a demo on synthetic material.
SENTIMENT_PROVIDER=auto
# Model identity lives in the profile (ADR 0021), not here. The key is the only secret.
CLASSIFY_PROFILE=jev-1.13.0
CLASSIFY_BASE_URL=https://api.typesafe.ai/v1
CLASSIFY_API_KEY=

# --- answer quality ----------------------------------------------------------
ANSWER_MIN_CONFIDENCE=0.45
RECALL_LIMIT=30
RERANK_LIMIT=5

# --- recruiter cabinet -------------------------------------------------------
# token:role:subject[:YYYY-MM-DD], comma separated. Use long random tokens.
ADMIN_TOKENS=replace-recruiter-token:recruiter:rec-1,replace-manager-token:manager:ИТ,replace-hr-token:hr_admin:hr-1:2030-12-31
DATA_RETENTION_DAYS=365
# Required in production; the scrape endpoint answers 401 without it.
METRICS_TOKEN=replace-with-a-long-random-token

# --- compose limits ----------------------------------------------------------
# Defaults fit a 1 GB demo host; raise them on a 2–4 GB pilot host.
# API_MEM_LIMIT=256m
# WORKER_MEM_LIMIT=256m
# POSTGRES_MEM_LIMIT=192m
# ADMIN_MEM_LIMIT=48m

# --- egress ------------------------------------------------------------------
# Leave empty when the host reaches GigaChat directly. Set only for a deployment behind a proxy.
# HTTPS_PROXY=socks5h://127.0.0.1:1080

