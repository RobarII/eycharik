{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshackathon.local/contracts/doc.schema.json",
  "title": "KnowledgeDocumentFrontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "owner", "audience", "valid_from"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "knowledge"},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(all|hr_only|dept:[a-z0-9_-]+)$"},
      "uniqueItems": true,
      "allOf": [
        {
          "if": {"contains": {"const": "all"}},
          "then": {
            "maxItems": 1,
            "description": "all уже значит всех; смешивать его с другим грантом бессмысленно и опасно: hr_only должен остаться hr_only"
          }
        }
      ]
    },
    "valid_from": {"type": "string", "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source_of_truth": {"type": "string"},
    "related": {"type": "array", "items": {"type": "string"}}
  }
}
